            .reduce(function (a, b) {
              return intVal(a) + intVal(b);
              let result= intVal(a) + intVal(b);
              return result.toFixed(2);
            }, 0);
            
            // Total over this page
            pageTotal = api
            .column(6, { page: 'current' })
            .data()
            .reduce(function (a, b) {
              let result= intVal(a) + intVal(b);
              return result.toFixed(2);
            }, 0);
            
            // Update footer
            $(api.column(6).footer()).html(pageTotal);
          },
        });
    });
  });



  $(document).ready(function () {
